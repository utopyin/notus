{
  "name": "notus",
  "version": "0.0.0",
  "workspaces": {
    "packages": [
      "packages/*",
      "domains/*",
      "entrypoints/*",
      "apps/*",
      "scripts"
    ],
    "catalog": {
      "effect": "4.0.0-rc.112",
      "@effect/platform-bun": "4.0.0-rc.112",
      "@effect/platform-browser": "4.0.0-rc.112",
      "@effect/platform-node": "4.0.0-rc.112",
      "@effect/sql-d1": "4.0.0-rc.112",
      "@effect/sql-sqlite-do": "4.0.0-rc.112",
      "alchemy": "2.0.0-beta.77",
      "@effect/ai-openai": "4.0.0-rc.112",
      "drizzle-orm": "1.0.0-rc.5-5935859",
      "drizzle-kit": "1.0.0-rc.5-5935859",
      "typescript": "7.0.2",
      "better-auth": "1.7.4",
      "@alchemy.run/better-auth": "2.0.0-beta.77"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "build": "turbo run build",
    "fix": "oxlint . --fix --disable-nested-config && oxfmt .",
    "check:types": "turbo run check:types && tsc",
    "check": "bun run fix && bun run check:types",
    "prepare": "effect-tsgo patch --oxlint",
    "deploy": "ALCHEMY_STAGE=\"$USER\" alchemy deploy --env-file .env.dev",
    "deploy:production": "ALCHEMY_STAGE=production alchemy deploy --env-file .env.production",
    "plan": "ALCHEMY_STAGE=\"$USER\" alchemy plan --env-file .env.dev",
    "destroy": "ALCHEMY_STAGE=\"$USER\" alchemy destroy --env-file .env.dev",
    "destroy:production": "ALCHEMY_STAGE=production alchemy destroy --env-file .env.production",
    "login:chatgpt": "bun run scripts/chatgpt/login.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@notus/stages": "workspace:*",
    "drizzle-kit": "catalog:",
    "mime": "4.1.0",
    "oxfmt": "^0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "^2.10.11",
    "typescript": "catalog:",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@effect/sql-d1": "4.0.0-rc.112",
    "@effect/sql-sqlite-do": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  },
  "packageManager": "bun@1.4.2"
}
