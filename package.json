{
  "name": "notus",
  "version": "0.0.0",
  "workspaces": {
    "packages": [
      "packages/*",
      "domains/*",
      "entrypoints/*",
      "apps/*",
      "scripts"
    ],
    "catalog": {
      "effect": "4.0.5",
      "@effect/platform-bun": "4.0.5",
      "@effect/platform-browser": "4.0.5",
      "@effect/platform-node": "4.0.5",
      "@effect/sql-d1": "4.0.5",
      "@effect/sql-sqlite-do": "4.0.5",
      "alchemy": "2.0.0-beta.83",
      "@effect/ai-openai": "4.0.5",
      "drizzle-orm": "1.0.0-rc.5-5935859",
      "drizzle-kit": "1.0.0-rc.5-5935859",
      "typescript": "7.0.2",
      "better-auth": "1.7.10",
      "@alchemy.run/better-auth": "2.0.0-beta.83"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "build": "turbo run build",
    "fix": "oxlint . --fix --disable-nested-config && oxfmt .",
    "check:types": "turbo run check:types && tsc",
    "check": "bun run fix && bun run check:types",
    "prepare": "effect-tsgo patch --oxlint",
    "deploy": "alchemy deploy --stage \"$USER\"",
    "deploy:production": "alchemy deploy --stage production",
    "plan": "alchemy plan --stage \"$USER\"",
    "destroy": "alchemy destroy --stage \"$USER\"",
    "destroy:production": "alchemy destroy --stage production",
    "login:chatgpt": "bun run scripts/chatgpt/login.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "0.53.4",
    "@notus/shared": "workspace:*",
    "drizzle-kit": "catalog:",
    "mime": "4.1.1",
    "oxfmt": "^0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "turbo": "^2.11.9",
    "typescript": "catalog:",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.5",
    "@effect/sql-d1": "4.0.5",
    "@effect/sql-sqlite-do": "4.0.5",
    "@effect/vitest": "4.0.5",
    "effect": "4.0.5",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.1",
    "prosemirror-view": "1.42.6"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "drizzle-orm@1.0.0-rc.5-5935859": "patches/drizzle-orm@1.0.0-rc.5-5935859.patch"
  }
}
