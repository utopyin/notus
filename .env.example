# Slack app
SLACK_APP_ID=
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Runtime: "simulation" (default) or "operator"
NOTUS_MODE=simulation
NOTUS_CONTROL_URL=
NOTUS_DASHBOARD_URL=
NOTUS_RUNTIME_KEY_ID=
NOTUS_RUNTIME_KEYS=

# Devbox providers this deployment runs, comma-separated (namespace, boat); namespace by default
NOTUS_COMPUTE_PROVIDERS="namespace, boat"
NOTUS_CREDENTIAL_KEY=

# Model
NOTUS_MODEL_PROVIDER=openai-api
NOTUS_MODEL=gpt-5.6-luna
NOTUS_REASONING_EFFORT=medium

# GitHub App and OAuth
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n
xxx
xxx
xxx\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
