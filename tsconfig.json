{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "include": ["./alchemy.run.ts"],
  "compilerOptions": {
    "target": "esnext",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // Drizzle rc.5 declarations still name Effect's pre-4.0 path; without this its SqlError is `any`.
    "paths": {
      "effect/unstable/sql/SqlError": ["./node_modules/effect/dist/sql/SqlError.d.ts"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": false
      }
    ],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true
  }
}
